<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<style>
  body { font-family: "Noto Sans CJK SC", sans-serif; font-size: 12px; }
  h1 { font-size: 18px; text-align: center; }
</style>
</head>
<body>
  <h1>送货单（草稿）</h1>
  <div>单号：{{ order_no }}　客户：{{ customer_name }}</div>
  <ul>
    {% for item in items %}<li>{{ item.product_name }} × {{ item.qty }}</li>{% endfor %}
  </ul>
  <div>合计：{{ total_amount }}</div>
</body>
</html>
